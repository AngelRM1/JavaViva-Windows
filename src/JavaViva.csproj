<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>JavaViva</AssemblyName>
    <RootNamespace>JavaViva</RootNamespace>
    <Version>1.1.7</Version>
    <AssemblyVersion>1.1.7.0</AssemblyVersion>
    <FileVersion>1.1.7.0</FileVersion>
    <Company>Nous Logic</Company>
    <Product>JavaViva - Juegos Java .jar como en tu celular de los 2000</Product>
    <Description>Launcher para Windows de juegos J2ME (.jar/.jad) con motor FreeJ2ME-Plus v1.53. Biblioteca, resolucion automatica o manual, perfiles de telefono y ajustes de compatibilidad por juego.</Description>
    <Copyright>Copyright (c) 2026 Nous Logic - nouslogic.xyz</Copyright>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="logo.png" />
    <EmbeddedResource Include="logo.ico" />
  </ItemGroup>
</Project>
